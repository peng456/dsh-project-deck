def in_quiet(cfg, ts=None):
    q = (cfg.get('schedule') or {}).get('quiet') or {}
    start, end = q.get('from'), q.get('to')
    if not start or not end:
        return False
    hm = datetime.fromtimestamp(ts or time.time()).strftime('%H:%M')
    if start <= end:
        return start <= hm < end
    return hm >= start or hm < end


def git_since(root, since, limit=3):
    try:
        r = subprocess.run(['git', '-C', root, 'log', '--since', str(int(since)), '-n', str(limit),
                            '--format=%ct%x1f%s'], capture_output=True, text=True, timeout=6)
        if r.returncode != 0:
            return []
        out = []
        for line in r.stdout.strip().splitlines():
            parts = line.split('\x1f', 1)
            if len(parts) == 2:
                out.append({'ts': int(parts[0]), 'subject': parts[1][:80]})
        return out
    except (OSError, subprocess.SubprocessError, ValueError):
        return []


def session_stats(root):
    """返回 {ids:[...], count, latest_at, latest_id}（按会话文件 mtime）。"""
    d = os.path.join(SESSION_ROOT, project_key(os.path.realpath(root or '')))
    out = {'ids': [], 'count': 0, 'latest_at': 0, 'latest_id': None}
    if not os.path.isdir(d):
        return out
    try:
        names = os.listdir(d)
    except OSError:
        return out
    for name in names:
        f = os.path.join(d, name, 'session.v3.jsonl.zstd')
        if not os.path.exists(f):
            continue
        try:
            mt = os.path.getmtime(f)
        except OSError:
            continue
        out['ids'].append(name)
        if mt > out['latest_at']:
            out['latest_at'] = mt
            out['latest_id'] = name
    out['count'] = len(out['ids'])
    return out


def latest_session_topic(root):
    """该项目最近会话的首条用户消息与时间（用于「进展」）。"""
    d = os.path.join(SESSION_ROOT, project_key(os.path.realpath(root or '')))
    if not os.path.isdir(d):
        return None
    best = None
    try:
        for name in os.listdir(d):
            f = os.path.join(d, name, 'session.v3.jsonl.zstd')
            if not os.path.exists(f):
                continue
            mt = os.path.getmtime(f)
            if best is None or mt > best[0]:
                best = (mt, f)
    except OSError:
        return None
    if not best:
        return None
    mt, f = best
    topic = ''
    try:
        proc = subprocess.Popen(['zstd', '-dc', f], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        raw = b''
        while raw.count(b'\n') < 25 and len(raw) < 200000:
            chunk = proc.stdout.read(65536)
            if not chunk:
                break
            raw += chunk
        proc.kill()
        proc.wait(timeout=5)
        for line in raw.splitlines()[:25]:
            try:
                j = json.loads(line)
            except Exception:
                continue
            if j.get('type') == 'user/message':
                content = (j.get('data') or {}).get('content') or []
                topic = ' '.join(' '.join(c.get('text', '') for c in content if isinstance(c, dict)).split())[:60]
                if topic:
                    break
    except Exception:
        pass
    return {'at': mt, 'topic': topic}


def collect(p):
    root = p.get('root', '')
    info = {
        'id': p['id'], 'name': p.get('name', p['id']), 'kind': p.get('kind', 'code'),
        'status': p.get('status', 'active'), 'priority': p.get('priority', 50),
        'exists': os.path.isdir(root), 'next': None, 'state_status': None,
        'board': None, 'git': None, 'activity': 0, 'memory': bool(p.get('memory')),
    }
    sf = state_file(p) if info['exists'] else None
    if sf:
        nxt, st = parse_state(sf)
        info['next'], info['state_status'] = nxt, st
        info['activity'] = max(info['activity'], os.path.getmtime(sf))
        info['memory'] = True
    if info['exists']:
        info['board'] = board_stats(root)
        if info['board']:
            info['activity'] = max(info['activity'], info['board']['latest'])
        info['git'] = git_info(root)
        if info['git']:
            info['activity'] = max(info['activity'], info['git']['ts'])
        try:
            info['activity'] = max(info['activity'], int(os.path.getmtime(root)))
        except OSError:
            pass
        info['activity'] = max(info['activity'], session_activity(root))
    return info


def rel_time(ts):
    if not ts:
        return '无记录'
    delta = time.time() - ts
    if delta < 90:
        return '刚刚'
    if delta < 3600:
        return f'{int(delta // 60)} 分钟前'
    if delta < 86400:
        return f'{int(delta // 3600)} 小时前'
    return f'{int(delta // 86400)} 天前'


# ── 播报生成 ────────────────────────────────────────────────
def build_report(cfg):
    rep = cfg.get('report', {})
    md = rep.get('format', 'markdown') == 'markdown'
    reg = load_json(REGISTRY, {'projects': []})
    projects = [p for p in reg.get('projects', []) if p.get('status') != 'archived']
    max_chars = int(rep.get('maxChars', 1200))

    state_now = load_json(STATE, {})
    prev_run = state_now.get('last_run') or (time.time() - 4 * 3600)
    prev_sessions = state_now.get('sessions') or {}

    entries = []
    for p in projects:
        info = collect(p)
        prog, changed = [], False
        commits = git_since(p.get('root', ''), prev_run) if info['exists'] else []
        if commits:
            prog.append(f"git {len(commits)} 次提交（{commits[0]['subject'][:40]}）")
            changed = True
        if info['git'] and info['git']['dirty']:
            prog.append(f"{info['git']['dirty']} 个文件待提交")
            changed = True
        stats = session_stats(p.get('root', '')) if info['exists'] else {'ids': [], 'count': 0, 'latest_at': 0, 'latest_id': None}
        prev = prev_sessions.get(p['id']) or {}
        prev_ids = set(prev.get('ids') or [])
        new_ids = [i for i in stats['ids'] if i not in prev_ids] if prev_ids else []
        if new_ids:
            prog.append(f"新增 {len(new_ids)} 个会话（共 {stats['count']}）")
            changed = True
        elif stats['latest_at'] and stats['latest_at'] > float(prev.get('latest_at') or 0):
            prog.append(f"会话更新（{rel_time(stats['latest_at'])}）")
            changed = True
        elif stats['count'] and not prev_ids:
            prog.append(f"会话 {stats['count']} 个（最近 {rel_time(stats['latest_at'])}）")
        topic = latest_session_topic(p.get('root', '')) if (info['exists'] and (new_ids or stats['latest_at'] > prev_run)) else None
        if topic and topic['topic']:
            prog.append(f"「{topic['topic'][:36]}」")
        if info['board'] and info['board']['total']:
            prog.append(f"看板 {info['board']['total']} 个目标")
            changed = True
        nxt = info['next'] or info.get('state_status') or p.get('note') or '（未登记进展）'
        if str(nxt).startswith('自动发现：'):
            nxt = '待确认项目目标与下一步（自动发现）'
        stale = bool(info['activity']) and time.time() - info['activity'] > 14 * 86400
        entries.append({'p': p, 'info': info, 'prog': prog, 'changed': changed, 'next': nxt,
                        'stale': stale, 'priority': p.get('priority', 50)})

    entries.sort(key=lambda e: (not e['changed'], -e['priority'], e['p']['id']))
    blocks, unchanged = [], []
    for e in entries:
        info, p = e['info'], e['p']
        if not e['changed']:
            unchanged.append(info['name'])
            continue
        rel = rel_time(info['activity'])
        missing = '' if info['exists'] else ' · ⚠ 目录不存在'
        stale_hint = ' · ⚠ 14 天未动' if e['stale'] else ''
        name, kind = info['name'], KINDS.get(info['kind'], info['kind'])
        blk = [f'- **{name}**（{kind}）· {rel}{missing}{stale_hint}' if md else f'{name}（{kind}）· {rel}{missing}{stale_hint}']
        blk.append('  进展：' + (' · '.join(e['prog']) if e['prog'] else '本期无新变化'))
        blk.append(f"  下一步：{e['next']}")
        bits = []
        if info['git']:
            g = info['git']
            bits.append(f"git {g['sha']}" + (f" +{g['dirty']} 改动" if g['dirty'] else ''))
        if not info['memory']:
            bits.append('未落盘')
        if bits:
            if md:
                bits = [f'`{b}`' for b in bits]
            blk.append('  ' + (' · '.join(bits) if md else ' / '.join(bits)))
        blocks.append('\n'.join(blk))

    blocked = [p for p in projects if p.get('status') == 'blocked']
    active = [p for p in projects if p.get('status') == 'active']
    infos = [e['info'] for e in entries]
    recent = [i for i in infos if i['activity'] and time.time() - i['activity'] < 6 * 3600]
    now = datetime.now()

    if md:
        lines = [f'**项目播报** · {now:%m-%d %H:%M}', '',
                 f'{len(projects)} 个项目｜活跃 {len(active)} · 阻塞 {len(blocked)} · 近 6 小时更新 {len(recent)}', '']
    else:
        lines = [f'【项目播报 {now:%m-%d %H:%M}】',
                 f'项目 {len(projects)} 个（活跃 {len(active)}，阻塞 {len(blocked)}），近 6 小时有更新 {len(recent)} 个', '']

    scan_st = load_json(SCAN_STATE, {})
    if scan_st.get('lastRun') and time.time() - scan_st['lastRun'] < 7 * 86400:
        added = scan_st.get('added') or []
        cands = scan_st.get('candidates') or []
        if added:
            lines.append('自动发现：新增 ' + str(len(added)) + ' 个项目（' + '、'.join(a['name'] for a in added[:3]) + '）')
        elif cands:
            lines.append(f'自动发现：{len(cands)} 个候选待确认（deck scan）')
        if added or cands:
            lines.append('')

    # 等你拍板 + 自主推进概览
    pend = [x for x in load_approvals().get('items', []) if x.get('status') == 'pending']
    if pend:
        lines.append(f'**等你拍板**：{len(pend)} 项')
        for x in pend[:3]:
            opts = f"（{x['options']}，推荐 {x.get('recommend') or '-'}）" if x.get('options') else ''
            lines.append(f"- {x['project']}：{x['question'][:50]}{opts}")
        lines.append('')
    modes = {'auto': 0, 'assist': 0, 'off': 0}
    for p in projects:
        modes[autonomy_of(p)['mode']] = modes.get(autonomy_of(p)['mode'], 0) + 1
    if modes['auto'] or modes['assist']:
        lines.append(f"自主推进：auto {modes['auto']} · assist {modes['assist']} · off {modes['off']}")
        lines.append('')

    # 节点离线提醒（超过 3 天没上报）
    try:
        off = []
        for n in load_nodes().get('nodes', []):
            if n.get('local'):
                continue
            ls = float(n.get('lastSeen') or 0)
            if not ls:
                off.append(f"{n.get('name') or n['id']}（从未上报）")
            elif time.time() - ls > 3 * 86400:
                off.append(f"{n.get('name') or n['id']}（{int((time.time()-ls)//86400)} 天）")
        if off:
            lines.append('节点离线：' + '、'.join(off))
            lines.append('')
    except Exception:
        pass

    budget = max_chars - len('\n'.join(lines)) - 200
    keep, total = [], 0
    for b in blocks:
        if total + len(b) + 1 > budget:
            break
        keep.append(b)
        total += len(b) + 1
    omitted = len(blocks) - len(keep)
    parts = keep[:]
    if unchanged:
        parts.append('无变化：' + '、'.join(unchanged[:8]) + ('…' if len(unchanged) > 8 else ''))
    if omitted:
        parts.append(f'……另有 {omitted} 个有变化的项目未展开')
    sep = '\n' if md else '\n\n'
    lines.append(sep.join(parts))
    if blocked:
        names = '、'.join(p.get('name', p['id']) for p in blocked)
        lines.append('')
        lines.append(f'**阻塞**：{names}' if md else f'阻塞：{names}')
    return '\n'.join(lines)



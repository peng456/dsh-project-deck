def _wx_state():
    st = load_json(WXPUSH_STATE, {})
    return st.get('bot_token'), st.get('context_token'), st.get('ilink_user_id'), \
        (st.get('api_base') or 'https://ilinkai.weixin.qq.com/ilink')


def _wx_headers(token):
    uin = base64.b64encode(str(secrets.randbelow(0xffffffff)).encode()).decode()
    return {'content-type': 'application/json', 'iLink-App-ClientVersion': '1',
            'X-WECHAT-UIN': uin, 'Authorization': f'Bearer {token}',
            'AuthorizationType': 'ilink_bot_token'}


def _wx_post(url, body, token, timeout=30):
    req = urllib.request.Request(url, data=json.dumps(body).encode(), headers=_wx_headers(token))
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return json.loads(r.read().decode())


def _aes_ecb(data, key):
    size = ((len(data) + 1 + 15) // 16) * 16
    plen = 16 - (len(data) % 16)
    padded = data + bytes([plen]) * plen
    try:
        from cryptography.hazmat.primitives.ciphers import Cipher, algorithms, modes
        enc = Cipher(algorithms.AES(key), modes.ECB()).encryptor()
        return enc.update(padded) + enc.finalize(), size
    except ImportError:
        # 系统 Python 3.9 没有 cryptography：退回 macOS 自带 openssl
        r = subprocess.run(['/usr/bin/openssl', 'enc', '-aes-128-ecb', '-K', key.hex(),
                            '-nosalt', '-nopad'], input=padded, capture_output=True)
        if r.returncode != 0:
            raise RuntimeError('AES 加密失败: ' + (r.stderr.decode()[:120]))
        return r.stdout, size


PENDING_IMG = os.path.join(BASE, 'pending-image.json')


def queue_image(png_path, caption=None):
    save_json(PENDING_IMG, {'path': png_path, 'caption': caption, 'at': time.time()})
    log(f'[image] 已入队待补发 {os.path.basename(png_path)}')


def flush_pending_image():
    p = load_json(PENDING_IMG, None)
    if not p:
        return False
    if channel_stale():
        return False
    # 失败后 2 分钟内不重复尝试，避免空转
    if time.time() - float(p.get('lastTry', 0)) < 120:
        return False
    p['lastTry'] = time.time()
    save_json(PENDING_IMG, p)
    path = p.get('path', '')
    if not os.path.exists(path):
        os.remove(PENDING_IMG)
        return False
    code, msg = send_wechat_image(path, p.get('caption'))
    if code == 0:
        try:
            os.remove(PENDING_IMG)
        except OSError:
            pass
        log('[image] 队列图片补发成功')
        return True
    if time.time() - float(p.get('at', 0)) > 3 * 86400:
        try:
            os.remove(PENDING_IMG)
        except OSError:
            pass
        log('[image] 队列图片超过 3 天，放弃')
    return False


def send_wechat_image(png_path, caption=None):
    token, ctx, uid, api = _wx_state()
    if not token or not ctx or not uid:
        return 2, 'wxpush 未授权（token/context_token 缺失）'
    try:
        raw = open(png_path, 'rb').read()
    except OSError as e:
        return 1, f'读图失败: {e}'
    rawsize = len(raw)
    rawmd5 = hashlib.md5(raw).hexdigest()
    key = secrets.token_bytes(16)
    ciphertext, filesize = _aes_ecb(raw, key)
    filekey = secrets.token_hex(16)
    up = _wx_post(api + '/bot/getuploadurl', {
        'filekey': filekey, 'media_type': 1, 'to_user_id': uid,
        'rawsize': rawsize, 'rawfilemd5': rawmd5, 'filesize': filesize,
        'no_need_thumb': True, 'aeskey': key.hex()}, token)
    url = up.get('upload_full_url') or up.get('upload_param')
    if not url:
        return 1, f'getuploadurl 失败: {str(up)[:120]}'
    if not str(url).startswith('http'):
        url = f'{CDN_BASE}/upload?encrypted_query_param={urllib.parse.quote(str(url))}&filekey={filekey}'
    req = urllib.request.Request(url, data=ciphertext,
                                 headers={'content-type': 'application/octet-stream'})
    with urllib.request.urlopen(req, timeout=120) as r:
        if r.status != 200:
            return 1, f'CDN 上传 HTTP {r.status}'
        download_param = r.headers.get('x-encrypted-param')
    if not download_param:
        return 1, 'CDN 上传响应缺少 x-encrypted-param'
    aes_b64 = base64.b64encode(key.hex().encode()).decode()
    body = {'msg': {'from_user_id': '', 'to_user_id': uid,
                    'client_id': f'deck:{int(time.time())}:{secrets.randbelow(999999)}',
                    'message_type': 2, 'message_state': 2, 'context_token': ctx,
                    'item_list': [{'type': 2, 'image_item': {
                        'media': {'encrypt_query_param': download_param, 'aes_key': aes_b64,
                                  'encrypt_type': 1},
                        'mid_size': filesize}}]},
            'base_info': {'channel_version': '1.0.0'}}
    res = _wx_post(api + '/bot/sendmessage', body, token)
    if res.get('ret', 0) != 0 and not res.get('message_id'):
        return 1, f'图片发送失败: {str(res)[:160]}'
    if caption:
        code, msg = send_wechat(caption)
        if code != 0:
            return code, '图片已发，说明文字未送达：' + msg
    log(f'[image] 已发送 {os.path.basename(png_path)} ({rawsize}B)')
    return 0, '图片已送达微信'



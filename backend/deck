def cmd_daemon():
    os.makedirs(os.path.dirname(LOCK), exist_ok=True)
    fh = open(LOCK, 'w')
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        log('已有守护进程在跑，退出')
        return 0
    fh.write(str(os.getpid()))
    fh.flush()
    log(f'守护进程启动 pid={os.getpid()}')
    while True:
        try:
            cfg = load_json(CONFIG, {})
            r = cfg.get('report', {})
            if in_quiet(cfg):
                time.sleep(60)
                continue
            try:
                flush_pending_image()
            except Exception as e:
                log(f'[image] 补发异常: {e!r}')
            # 自动发现：按 scan.intervalHours 周期扫描
            sc = cfg.get('scan', {})
            if sc.get('enabled', True):
                sst = load_json(SCAN_STATE, {})
                sinterval = float(sc.get('intervalHours', 24)) * 3600
                if time.time() - float(sst.get('lastRun', 0)) >= sinterval:
                    try:
                        auto_scan(cfg)
                    except Exception as e:
                        log(f'[scan] 异常: {e!r}')
            if r.get('enabled', True):
                st = load_json(STATE, {})
                last = st.get('last_run', 0)
                interval = float(r.get('intervalHours', 4)) * 3600
                if time.time() - last >= interval:
                    do_report_with_image(cfg, quiet=True)
                    st['last_run'] = time.time()
                    save_json(STATE, st)
        except Exception as e:  # 守护进程不能因单次失败退出
            log(f'循环异常: {e!r}')
        time.sleep(30)


def cmd_demo(argv):
    """deck demo：生成一个演示环境（假项目 + 独立面板端口），不碰真实注册表。"""
    import shutil
    home = os.path.expanduser('~/.project-deck-demo')
    port = '9299'
    for i, a in enumerate(argv):
        if a == '--port' and i + 1 < len(argv):
            port = argv[i + 1]
    if os.path.isdir(home):
        shutil.rmtree(home)
    os.makedirs(home, exist_ok=True)
    projects = [
        ('website', '官网改版', 'content', '落地页文案与设计，本周出第一版'),
        ('api-server', 'API 服务', 'code', '把 v1 接口迁到 v2，补 12 个测试'),
        ('notes-app', '笔记应用', 'code', '离线同步还有 2 个 bug'),
        ('infra', '基础设施', 'ops', '备份脚本换成 restic，验证一次恢复'),
    ]
    reg = {'version': 1, 'projects': []}
    for pid, name, kind, note in projects:
        root = os.path.join(home, 'projects', pid)
        os.makedirs(root, exist_ok=True)
        open(os.path.join(root, 'README.md'), 'w').write(f'# {name}\n\n{note}\n')
        if kind == 'code':
            open(os.path.join(root, 'package.json'), 'w').write('{"name":"%s","version":"0.1.0"}\n' % pid)
        subprocess.run(['git', 'init', '-q'], cwd=root)
        subprocess.run(['git', '-c', 'user.name=demo', '-c', 'user.email=demo@example.com',
                        'commit', '-qm', f'init: {name}', '--allow-empty'], cwd=root)
        reg['projects'].append({'id': pid, 'name': name, 'aliases': [pid], 'kind': kind,
                                'status': 'active', 'priority': 60, 'root': root,
                                'memory': None, 'note': note,
                                'created_at': time.strftime('%Y-%m-%dT%H:%M:%S%z')})
    cfg = {'version': 1,
           'report': {'enabled': False, 'intervalHours': 4, 'format': 'markdown', 'image': False},
           'scan': {'enabled': False, 'intervalHours': 12},
           'panel': {'allowLanRead': False}}
    save_json(os.path.join(home, 'registry.json'), reg)
    save_json(os.path.join(home, 'config.json'), cfg)
    os.makedirs(os.path.join(home, 'graphics'), exist_ok=True)
    print(f'演示环境: {home}')
    print(f'面板地址: http://127.0.0.1:{port}  (Ctrl-C 结束)')
    env = dict(os.environ, DECK_HOME=home, DECK_PANEL_PORT=str(port), DECK_PANEL_HOST='127.0.0.1')
    try:
        subprocess.run([sys.executable, os.path.join(os.path.dirname(os.path.abspath(__file__)), 'panel.py')], env=env)
    except KeyboardInterrupt:
        pass
    return 0


def main():
    args = sys.argv[1:]
    if not args:
        return cmd_status()
    cmd, rest = args[0], args[1:]
    if cmd in ('list', 'ls'):
        return cmd_list()
    if cmd == 'add':
        return cmd_add(rest)
    if cmd == 'rm':
        return cmd_rm(rest)
    if cmd == 'every':
        return cmd_every(rest)
    if cmd == 'format':
        return cmd_format(rest)
    if cmd == 'scan':
        return cmd_scan(rest)
    if cmd == 'nodes':
        return cmd_nodes(rest)
    if cmd == 'image':
        return cmd_image(rest)
    if cmd == 'on':
        return cmd_toggle(True)
    if cmd == 'off':
        return cmd_toggle(False)
    if cmd == 'status':
        return cmd_status()
    if cmd == 'doctor':
        return cmd_doctor()
    if cmd == 'preview':
        print(build_report(load_json(CONFIG, {})))
        return 0
    if cmd == 'report':
        cfg0 = load_json(CONFIG, {})
        force = False if '--no-image' in rest else (True if '--image' in rest else None)
        code, text, msg = do_report_with_image(cfg0, force=force)
        st = load_json(STATE, {})
        st['last_run'] = time.time()
        save_json(STATE, st)
        return code
    if cmd == 'autonomy':
        return cmd_autonomy(rest)
    if cmd == 'decide':
        return cmd_decide(rest)
    if cmd == 'ask':
        return cmd_ask(rest)
    if cmd == 'approvals':
        return cmd_approvals(rest)
    if cmd == 'decisions':
        return cmd_decisions(rest)
    if cmd == 'demo':
        return cmd_demo(rest)
    if cmd == 'panel':
        port = os.environ.get('DECK_PANEL_PORT', '9199')
        url = f'http://127.0.0.1:{port}'
        print(f'管理面板: {url}')
        try:
            subprocess.run(['open', url], timeout=5)
        except (OSError, subprocess.SubprocessError):
            pass
        return 0
    if cmd == 'daemon':
        return cmd_daemon()
    print(__doc__)
    return 1


if __name__ == '__main__':
    sys.exit(main())

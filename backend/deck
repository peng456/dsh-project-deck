EXCLUDE_NAMES = {'.git', 'node_modules', '.venv', 'venv', '__pycache__', 'Library',
                 'Applications', 'Movies', 'Music', 'Pictures', 'Public', 'Downloads',
                 '.npm', '.cache', '.Trash', '.DS_Store', 'dist', 'build', 'target',
                 'go', 'vendor', 'attachments', 'logs'}
MARKERS = ['.git', 'package.json', 'pnpm-workspace.yaml', 'pyproject.toml', 'setup.py',
           'go.mod', 'Cargo.toml', 'AGENTS.md', 'CLAUDE.md', '.dsh-graph', 'README.md']


def dsh_workspaces():
    """DSH 工作区 = 用户真实用过的「工作分区」，带会话数与最近活跃时间。"""
    data = load_json(WS_STORE, {})
    out = {}
    for wid, w in (data.get('tables', {}).get('workspaces') or {}).items():
        path = os.path.realpath(w.get('path', '') or '')
        if not path:
            continue
        sids = w.get('sessionIds') or []
        latest = 0
        for sid in sids:
            for f in glob.glob(os.path.join(HOME, '.dsh', 'sessions', '*', sid + '*')):
                try:
                    latest = max(latest, os.path.getmtime(f))
                except OSError:
                    pass
        out[path] = {'path': path, 'title': w.get('title') or os.path.basename(path),
                     'sessions': len(sids), 'last': latest}
    return out


def is_excluded(path):
    parts = set(path.split(os.sep))
    if parts & EXCLUDE_NAMES:
        return True
    if path.startswith(os.path.join(HOME, '.dsh')) or path.startswith(os.path.join(HOME, '.ai')):
        return True
    if path.startswith(os.path.join(HOME, 'Library')):
        return True
    return False


def _marker_info(path):
    found = []
    latest = 0
    for m in MARKERS:
        fp = os.path.join(path, m)
        if os.path.exists(fp):
            found.append(m)
            if m == '.git':
                continue  # .git 的 mtime 会被 git 自身刷新，不代表项目活跃
            try:
                latest = max(latest, os.path.getmtime(fp))
            except OSError:
                pass
    return found, latest


def scan_filesystem(cfg):
    scan = cfg.get('scan', {})
    roots = scan.get('roots', [os.path.join(HOME, 'Desktop'), HOME])
    depth = int(scan.get('depth', 1))
    found = {}
    for r in roots:
        base = os.path.realpath(os.path.expanduser(r))
        if not os.path.isdir(base):
            continue
        # 扫描根本身不是项目（例如家目录 / 桌面）
        found.pop(base, None)
        level = [(base, 0)]
        while level:
            cur, d = level.pop()
            if d >= depth:
                continue
            try:
                entries = sorted(os.scandir(cur), key=lambda e: e.name)
            except OSError:
                continue
            for e in entries:
                if not e.is_dir(follow_symlinks=False) or e.name.startswith('.'):
                    continue
                if e.name in EXCLUDE_NAMES:
                    continue
                sub = os.path.realpath(e.path)
                if is_excluded(sub):
                    continue
                markers, latest = _marker_info(sub)
                if markers:
                    found[sub] = {'markers': markers, 'last': latest}
                # 只对根目录的一级做 marker 判断；更深层仅当自身像项目才继续
                level.append((sub, d + 1))
    return found


def load_nodes():
    return load_json(NODES, {'version': 1, 'nodes': []})


def find_node(node_id):
    return next((n for n in load_nodes().get('nodes', []) if n.get('id') == node_id), None)


def remote_snapshots():
    out = []
    if not os.path.isdir(NODE_SNAPS):
        return out
    for f in sorted(glob.glob(os.path.join(NODE_SNAPS, '*.json'))):
        snap = load_json(f, None)
        if isinstance(snap, dict) and snap.get('node'):
            out.append(snap)
    return out


def save_node_scan(payload):
    node_id = str(payload.get('node') or '').strip()
    node = find_node(node_id)
    if not node:
        raise ValueError(f'未登记的节点 {node_id}')
    token = str(payload.get('token') or '')
    import hmac
    if not token or not hmac.compare_digest(token, str(node.get('token') or '')):
        raise ValueError('节点 token 不正确')
    projects = payload.get('projects') or []
    if not isinstance(projects, list) or len(projects) > 2000:
        raise ValueError('projects 字段非法')
    snap = {'node': node_id, 'name': node.get('name') or node_id,
            'platform': node.get('platform', ''), 'scanned_at': time.time(),
            'projects': projects}
    os.makedirs(NODE_SNAPS, exist_ok=True)
    save_json(os.path.join(NODE_SNAPS, node_id + '.json'), snap)
    node['lastSeen'] = time.time()
    nodes = load_nodes()
    for n in nodes['nodes']:
        if n['id'] == node_id:
            n['lastSeen'] = node['lastSeen']
    save_json(NODES, nodes)
    log(f'[node] {node_id} 上报 {len(projects)} 个项目')
    return snap



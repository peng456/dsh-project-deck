def cmd_add(argv):
    if not argv:
        print('用法: deck add <id> --root <path> [--name 名称] [--kind code] [--note 说明]')
        return 1
    pid = argv[0]
    opts = {}
    i = 1
    while i < len(argv):
        k = argv[i]
        if k.startswith('--') and i + 1 < len(argv):
            opts[k[2:]] = argv[i + 1]
            i += 2
        else:
            i += 1
    if 'root' not in opts:
        print('缺少 --root')
        return 1
    root = os.path.realpath(os.path.expanduser(opts['root']))
    if not os.path.isdir(root):
        print(f'目录不存在: {root}')
        return 1
    reg = load_json(REGISTRY, {'projects': []})
    for p in reg['projects']:
        if p['id'] == pid:
            print(f'已存在项目 {pid}')
            return 1
        if os.path.realpath(p.get('root', '')) == root:
            print(f'该目录已绑定项目 {p["id"]}')
            return 1
    reg['projects'].append({
        'id': pid, 'name': opts.get('name', pid), 'aliases': [pid],
        'kind': opts.get('kind', 'code'), 'status': 'active',
        'priority': int(opts.get('priority', 50)), 'root': root,
        'memory': None, 'note': opts.get('note', ''),
        'created_at': datetime.now().astimezone().isoformat(timespec='seconds'),
    })
    save_json(REGISTRY, reg)
    print(f'已登记 {pid} → {root}')
    return 0


def cmd_rm(argv):

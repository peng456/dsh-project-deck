    projects.sort(key=lambda p: (-p.get('priority', 50), p['id']))
    infos = [(p, collect(p)) for p in projects[:limit]]
    active = sum(1 for p in projects if p.get('status') == 'active')
    blocked = sum(1 for p in projects if p.get('status') == 'blocked')
    recent = sum(1 for _, i in infos if i['activity'] and time.time() - i['activity'] < 6 * 3600)
    st = load_json(STATE, {})
    rep = cfg.get('report', {})
    nxt = (st.get('last_run') or 0) + float(rep.get('intervalHours', 4)) * 3600

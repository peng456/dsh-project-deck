def channel_state():
    return load_json(CHANNEL_STATE, {'stale': False, 'fails': 0})


def _ctx_hash():
    st = load_json(WXPUSH_STATE, {})
    token = st.get('context_token') or ''
    return hashlib.sha256(token.encode()).hexdigest()[:16]


def channel_stale():
    st = channel_state()
    if not st.get('stale'):
        return False
    # 用户给 bot 发过消息 → context_token 变了 → 自动解除 stale
    if st.get('ctx') and st['ctx'] != _ctx_hash():
        save_json(CHANNEL_STATE, {'stale': False, 'fails': 0, 'lastOk': time.time()})
        log('[channel] 检测到 context_token 已刷新，恢复播报')
        return False
    return True


def mark_channel(ok, err=''):
    st = channel_state()
    if ok:
        st = {'stale': False, 'fails': 0, 'lastOk': time.time()}
    else:
        st['fails'] = int(st.get('fails', 0)) + 1
        st['ctx'] = _ctx_hash()
        st['lastError'] = (err or '')[:200]
        st['at'] = time.time()
        if st['fails'] >= 2:
            st['stale'] = True
    save_json(CHANNEL_STATE, st)


def send_wechat(text):
    if not os.path.exists(WXSEND):
        return 3, 'wxsend 不存在'
    r = subprocess.run([WXSEND], input=text, capture_output=True, text=True, timeout=30)
    msg = (r.stdout or r.stderr).strip()
    if r.returncode == 0:
        mark_channel(True)
    elif r.returncode == 2:
        mark_channel(False, msg.splitlines()[0] if msg else 'queued')
    return r.returncode, msg


def refresh_local_node(cfg=None):
    """把本机也当作一个节点：播报前刷新一次快照，面板里就不会显示「离线」。"""
    cfg = cfg or load_json(CONFIG, {})

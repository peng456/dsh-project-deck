def state_file(p):
    mem = p.get('memory')
    if not mem:
        return None
    path = os.path.join(HOME, '.ai', 'projects', mem.get('project', p['id']),
                        'memory', 'designs', mem.get('slug', p['id']), 'STATE.md')
    return path if os.path.exists(path) else None


NEXT_RE = re.compile(r'next[_ ]?action\s*[:：]\s*\*{0,2}\s*(.+)', re.I)
STATUS_RE = re.compile(r'^\s*[-*]?\s*(?:status|状态)\s*[:：]\s*(.+)', re.I | re.M)


def parse_state(path):
    try:
        text = open(path, encoding='utf-8', errors='replace').read(200000)
    except OSError:
        return None, None
    m = NEXT_RE.search(text)
    nxt = m.group(1).strip().strip('*').strip()[:120] if m else None
    s = STATUS_RE.search(text)
    st = s.group(1).strip()[:60] if s else None
    return nxt, st


def board_stats(root):
    bdir = os.path.join(root, '.dsh-graph')
    if not os.path.isdir(bdir):
        return None
    goals_dir = os.path.join(bdir, 'goals')
    counts = {}
    latest = 0
    if os.path.isdir(goals_dir):
        for name in os.listdir(goals_dir):
            gpath = os.path.join(goals_dir, name, 'goal.md')
            if not os.path.isfile(gpath):
                continue
            latest = max(latest, os.path.getmtime(gpath))
            try:
                head = open(gpath, encoding='utf-8', errors='replace').read(1200)
            except OSError:
                continue
            m = re.search(r'^status:\s*(\S+)', head, re.M)
            st = m.group(1).strip('"\'') if m else 'unknown'
            counts[st] = counts.get(st, 0) + 1
    return {'counts': counts, 'total': sum(counts.values()), 'latest': latest}


def git_info(root):
    try:
        r = subprocess.run(['git', '-C', root, 'log', '-1', '--format=%ct%x1f%h%x1f%s'],
                           capture_output=True, text=True, timeout=5)
        if r.returncode != 0 or not r.stdout.strip():
            return None
        ts, sha, subj = r.stdout.strip().split('\x1f', 2)
        dirty = subprocess.run(['git', '-C', root, 'status', '--porcelain'],
                               capture_output=True, text=True, timeout=5).stdout
        return {'ts': int(ts), 'sha': sha, 'subject': subj[:80],
                'dirty': len([l for l in dirty.splitlines() if l.strip()])}
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


SESSION_ROOT = os.path.join(HOME, '.dsh', 'sessions')


def project_key(cwd):
    out, sep = [], False
    for ch in cwd:
        code = ord(ch)
        if ch in '/\\:':
            if not sep:
                out.append('-')
            sep = True
        elif ch != '~' and (ch.isalnum() or ch in '._-') and code < 128:
            out.append(ch)
            sep = False
        else:
            out.append('~%04X' % code)
            sep = False
    s = ''.join(out).lstrip('-') or 'root'
    return '--' + s[:251] + '--'


def session_activity(root):
    """该项目工作区下最近一次会话活动时间（用于播报里的「最近活动」）。"""
    if not root:
        return 0
    d = os.path.join(SESSION_ROOT, project_key(os.path.realpath(root)))
    if not os.path.isdir(d):
        return 0
    latest = 0
    try:
        for name in os.listdir(d):
            f = os.path.join(d, name, 'session.v3.jsonl.zstd')
            if os.path.exists(f):
                try:
                    latest = max(latest, os.path.getmtime(f))
                except OSError:
                    pass
    except OSError:
        return 0
    return latest


def autonomy_of(p):
    a = p.get('autonomy') or {}
    mode = a.get('mode', 'off')
    if mode not in AUTONOMY_MODES:
        mode = 'off'
    return {'mode': mode, 'maxPerDay': int(a.get('maxPerDay', 3)),
            'day': a.get('day', ''), 'actionsToday': int(a.get('actionsToday', 0))}


def _today():
    return datetime.now().strftime('%Y-%m-%d')


def can_act(p):
    a = autonomy_of(p)
    if a['mode'] == 'off':
        return False, 'off'
    if a['day'] != _today():
        return a['mode'] != 'off', 'new-day'
    if a['actionsToday'] >= a['maxPerDay']:
        return False, f"预算用尽（{a['actionsToday']}/{a['maxPerDay']}）"
    return True, 'ok'


def bump_actions(pid):
    reg = load_json(REGISTRY, {'projects': []})
    for p in reg['projects']:
        if p['id'] == pid:
            a = autonomy_of(p)
            if a['day'] != _today():
                a['day'] = _today(); a['actionsToday'] = 0
            a['actionsToday'] += 1
            p['autonomy'] = a
    save_json(REGISTRY, reg)


def record_decision(pid, question, options, choice, why, reversible=True, mode=None):
    entry = {'at': time.time(), 'project': pid, 'question': question,
             'options': options, 'choice': choice, 'why': why,
             'reversible': bool(reversible), 'mode': mode or ''}
    with open(DECISIONS, 'a') as f:
        f.write(json.dumps(entry, ensure_ascii=False) + '\n')
    log(f'[autonomy] decision {pid}: {choice} ({question[:40]})')
    return entry


def load_approvals():
    return load_json(APPROVALS, {'items': []})


def add_approval(pid, question, options, recommend='', irreversible=True):
    d = load_approvals()
    item = {'id': 'ap-' + secrets.token_hex(4), 'project': pid, 'question': question,
            'options': options, 'recommend': recommend, 'irreversible': bool(irreversible),
            'createdAt': time.time(), 'status': 'pending'}
    d.setdefault('items', []).append(item)
    save_json(APPROVALS, d)
    log(f'[autonomy] approval {item["id"]} {pid}: {question[:50]}')
    return item


def resolve_approval(aid, decision, choice='', why=''):
    d = load_approvals()
    for it in d.get('items', []):
        if it['id'] == aid and it['status'] == 'pending':
            it['status'] = 'approved' if decision == 'approve' else 'rejected'
            it['resolvedAt'] = time.time()
            it['humanChoice'] = choice or it.get('recommend', '')
            if why:
                it['note'] = why
            save_json(APPROVALS, d)
            record_decision(it['project'], it['question'], it.get('options', []),
                            it['humanChoice'] if decision == 'approve' else 'rejected',
                            'human: ' + (why or decision), True, 'human')
            return it
    return None


def cmd_autonomy(argv):
    if not argv:
        reg = load_json(REGISTRY, {'projects': []})
        rows = [(p['id'], autonomy_of(p)) for p in reg['projects']]
        for pid, a in rows:
            print(f"{pid:22} {a['mode']:7} 今日 {a['actionsToday']}/{a['maxPerDay']}")
        return 0
    pid = argv[0]
    reg = load_json(REGISTRY, {'projects': []})
    proj = next((p for p in reg['projects'] if p['id'] == pid), None)
    if not proj:
        print('项目不存在'); return 1
    if len(argv) < 2:
        a = autonomy_of(proj); print(f"{pid}: {a['mode']} 今日 {a['actionsToday']}/{a['maxPerDay']}"); return 0
    mode = argv[1]
    if mode not in AUTONOMY_MODES:
        print('模式只能是 off / assist / auto'); return 1
    a = autonomy_of(proj)
    a['mode'] = mode
    if '--max' in argv:
        try: a['maxPerDay'] = int(argv[argv.index('--max') + 1])
        except (IndexError, ValueError): pass
    proj['autonomy'] = a
    save_json(REGISTRY, reg)
    print(f"{pid}: 自主模式 → {mode}（每日上限 {a['maxPerDay']}）")
    return 0


def cmd_decide(argv):
    if not argv:
        print('用法: deck decide <id> --question Q --options A|B|C --choice B --why "..." [--irreversible]')
        return 1
    pid = argv[0]
    opts = {}
    i = 1
    while i < len(argv):
        if argv[i].startswith('--') and i + 1 < len(argv):
            opts[argv[i][2:]] = argv[i + 1]; i += 2
        else: i += 1
    q = opts.get('question', ''); choice = opts.get('choice', '')
    if not q or not choice:
        print('缺少 --question / --choice'); return 1
    record_decision(pid, q, opts.get('options', ''), choice, opts.get('why', ''),
                    not ('irreversible' in opts or '--irreversible' in argv))
    bump_actions(pid)
    print('已记录决策')
    return 0


def cmd_ask(argv):
    if not argv:
        print('用法: deck ask <id> --question Q --options A,B [--recommend A]')
        return 1
    pid = argv[0]; opts = {}
    i = 1
    while i < len(argv):
        if argv[i].startswith('--') and i + 1 < len(argv):
            opts[argv[i][2:]] = argv[i + 1]; i += 2
        else: i += 1
    q = opts.get('question', '')
    if not q: print('缺少 --question'); return 1
    it = add_approval(pid, q, opts.get('options', ''), opts.get('recommend', ''))
    print('已加入审批队列:', it['id'])
    return 0



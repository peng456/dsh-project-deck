def render_image(cfg=None, out=None):
    cfg = cfg or load_json(CONFIG, {})
    os.makedirs(GRAPHICS, exist_ok=True)
    html = dashboard_html(cfg)
    ts = datetime.now().strftime('%Y%m%d-%H%M%S')
    html_path = os.path.join(GRAPHICS, 'board-' + ts + '.html')
    png_path = out or os.path.join(GRAPHICS, 'board-' + ts + '.png')
    with open(html_path, 'w', encoding='utf-8') as f:
        f.write(html)
    height = 900
    try:
        r = subprocess.run([CHROME, '--headless=new', '--disable-gpu',
                            '--virtual-time-budget=1500', '--dump-dom', 'file://' + html_path],
                           capture_output=True, timeout=60, text=True)
        m = re.search(r'<title>H(\d+)</title>', r.stdout or '')
        if m:
            height = int(m.group(1)) + 2
    except Exception:
        pass
    subprocess.run([CHROME, '--headless=new', '--disable-gpu', '--hide-scrollbars',
                    '--force-device-scale-factor=1', '--window-size=1080,' + str(height),
                    '--screenshot=' + png_path, 'file://' + html_path],
                   capture_output=True, timeout=60)
    if not os.path.exists(png_path):
        raise RuntimeError('截图失败（chrome headless）')
    for f in sorted(glob.glob(os.path.join(GRAPHICS, 'board-*.png')))[:-20]:
        try:
            os.remove(f)
        except OSError:
            pass
    return png_path


def cmd_image(argv):
    cfg = load_json(CONFIG, {})
    rep = cfg.setdefault('report', {})
    if '--on' in argv or '--off' in argv:
        rep['image'] = '--on' in argv
        save_json(CONFIG, cfg)
        print('周期播报附图：' + ('开启' if rep['image'] else '关闭'))
        return 0
    try:
        png = render_image(cfg)
    except Exception as e:
        print('生成图片失败:', e)
        return 1
    print('图片:', png)
    if '--no-send' in argv:
        return 0
    reg = load_json(REGISTRY, {'projects': []})
    n = len([p for p in reg.get('projects', []) if p.get('status') != 'archived'])
    caption = f'项目播报 · {n} 个项目 · {datetime.now():%m-%d %H:%M}'
    code, msg = send_wechat_image(png, caption)
    if code != 0:
        queue_image(png, caption)
    print(f'[wechat exit {code}] {msg}')
    return code



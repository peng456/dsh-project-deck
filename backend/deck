def do_report(cfg, quiet=False):
    text = build_report(cfg)
    if channel_stale():
        log('[report] 跳过：微信通道 context_token 过期（等你给 bot 发消息刷新）')
        if not quiet:
            print('⚠️ 微信通道过期，本次播报已跳过（不排队）；在微信里给 bot 发任意一句话即可恢复')
        return 2, text, 'SKIP_CHANNEL_STALE'
    with open(LAST, 'w') as f:
        f.write(text + '\n')
    code, msg = send_wechat(text)
    try:
        save_session_snapshot()
    except Exception as e:
        log(f'[report] 会话快照失败: {e!r}')
    try:
        refresh_local_node(cfg)
    except Exception as e:
        log(f'[node] 本机快照刷新异常: {e!r}')
    log(f'report exit={code} {msg.splitlines()[-1] if msg else ""}')
    # 播报历史（面板读取）
    try:
        with open(HISTORY, 'a') as h:
            h.write(json.dumps({'at': time.time(), 'exit': code, 'text': text},
                               ensure_ascii=False) + '\n')
    except OSError:
        pass
    if not quiet:
        print(text)
        print(f'\n[wechat exit {code}] {msg}')
    return code, text, msg



def do_report_with_image(cfg, quiet=False, force=None):
    """播报（文字）+ 可选附图；force=True/False 覆盖 config，None 跟随 config。"""
    code, text, msg = do_report(cfg, quiet)
    want = cfg.get('report', {}).get('image') if force is None else force
    if code == 0 and want:
        try:
            png = render_image(cfg)
            icode, imsg = send_wechat_image(png)
            if icode != 0:
                queue_image(png, None)
            log(f'[image] 附图 exit={icode} {imsg}')
            if not quiet:
                print(f'[image exit {icode}] {imsg}')
        except Exception as e:
            log(f'[image] 附图失败: {e!r}')
            if not quiet:
                print('附图失败:', e)
    return code, text, msg



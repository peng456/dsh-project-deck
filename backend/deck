def slugify(text):
    s = re.sub(r'[^a-z0-9]+', '-', (text or '').lower()).strip('-')
    return s or 'project'


def load_ignore():
    return load_json(SCAN_IGNORE, {'ignore': {}, 'blocked': []})


def is_ignored(path):
    ig = load_ignore()
    now = time.time()
    for prefix in ig.get('blocked', []):
        if path == prefix or path.startswith(prefix.rstrip('/') + '/'):
            return True
    until = (ig.get('ignore') or {}).get(path)
    return bool(until and until > now)


def discover(cfg=None):
    cfg = cfg or load_json(CONFIG, {})
    scan = cfg.get('scan', {})
    threshold = int(scan.get('threshold', 70))
    reg = load_json(REGISTRY, {'projects': []})
    known = {os.path.realpath(p.get('root', '')): p for p in reg['projects']}
    ws = dsh_workspaces()
    fs = scan_filesystem(cfg)
    now = time.time()
    paths = set(ws) | set(fs)
    out = []
    home = os.path.realpath(HOME)
    for path in sorted(paths):
        if path in (home, os.path.realpath(os.path.expanduser('~/Desktop'))):
            continue
        if path in known or is_excluded(path) or is_ignored(path):
            continue
        # 嵌套在已登记项目内部的目录不算新项目
        if any(path != root and path.startswith(root + os.sep) for root in known):
            continue
        if not os.path.isdir(path):
            continue
        info = ws.get(path, {})
        markers = fs.get(path, {}).get('markers', [])
        git = git_info(path)
        score, reasons = 0, []
        if info:
            score += 50
            reasons.append(f'DSH 工作区（{info["sessions"]} 个会话）')
            if info['last'] and now - info['last'] < 30 * 86400:
                score += 15
                reasons.append('近 30 天用过')
            elif info['last'] and now - info['last'] < 90 * 86400:
                score += 5
        if git:
            score += 30
            reasons.append(f'git 仓库（{git["subject"][:24]}）')
            if git['ts'] and now - git['ts'] < 30 * 86400:
                score += 10
                reasons.append('近 30 天有提交')
        if markers:
            score += 5 * min(len(markers), 2)
            reasons.append('含 ' + ' / '.join(markers[:3]))
        activity = max([info.get('last', 0), fs.get(path, {}).get('last', 0),
                        git['ts'] if git else 0,
                        os.path.getmtime(path) if os.path.exists(path) else 0])
        name = info.get('title') or os.path.basename(path)
        out.append({
            'path': path, 'name': name, 'id': slugify(name), 'kind': 'code',
            'score': min(score, 100), 'reasons': reasons, 'git': git,
            'sessions': info.get('sessions', 0), 'last': activity,
            'workspace': bool(info), 'auto': score >= threshold,
        })
    # 远程节点上报的项目
    seen_paths = {c['path'] for c in out}
    for snap in remote_snapshots():
        node_id = snap.get('node')
        for rp in snap.get('projects') or []:
            path = str(rp.get('path') or '').strip()
            if not path or path in known or path in seen_paths:
                continue
            seen_paths.add(path)
            markers = rp.get('markers') or []
            git = rp.get('git')
            score = 25
            reasons = [f'来自节点 {snap.get("name") or node_id}']
            if git:
                score += 30
                reasons.append('git 仓库')
            if markers:
                score += 5 * min(len(markers), 2)
                reasons.append('含 ' + ' / '.join(markers[:2]))
            last = float(rp.get('last') or snap.get('scanned_at') or 0)
            last = min(last, now)
            if last and now - last < 30 * 86400:
                score += 10
                reasons.append('近 30 天有改动')
            out.append({
                'path': path, 'name': rp.get('name') or os.path.basename(path),
                'id': slugify(rp.get('name') or os.path.basename(path)), 'kind': rp.get('kind', 'code'),
                'score': min(score, 100), 'reasons': reasons, 'git': git, 'sessions': 0,
                'last': last, 'workspace': False, 'node': node_id,
                'auto': score >= threshold and node_id in {n['id'] for n in load_nodes().get('nodes', [])},
            })
    out.sort(key=lambda x: (-x['score'], -x['last']))
    return out


def auto_scan(cfg=None):
    """扫描 + 自动登记高置信度候选，返回本次结果摘要。"""
    cfg = cfg or load_json(CONFIG, {})
    cands = discover(cfg)
    auto = [c for c in cands if c['auto']]
    added = []
    if cfg.get('scan', {}).get('autoAdd', True) and auto:
        reg = load_json(REGISTRY, {'projects': []})
        used = {p['id'] for p in reg['projects']}
        for c in auto:
            pid = c['id']
            n = 2
            while pid in used:
                pid = f"{c['id']}-{n}"
                n += 1
            used.add(pid)
            reg['projects'].append({
                'id': pid, 'name': c['name'], 'aliases': [pid, c['name']],
                'kind': c['kind'], 'status': 'active', 'priority': 40,
                'root': c['path'], 'memory': None,
                'note': '自动发现：' + '；'.join(c['reasons'][:3]),
                'created_at': datetime.now().astimezone().isoformat(timespec='seconds'),
            })
            added.append({'id': pid, 'name': c['name'], 'path': c['path'], 'score': c['score']})
        if added:
            save_json(REGISTRY, reg)
    st = load_json(SCAN_STATE, {})
    cands_sorted = sorted([c for c in cands if not c['auto']], key=lambda c: -c['score'])[:30]
    st.update({'lastRun': time.time(), 'added': added, 'candidates': cands_sorted})
    save_json(SCAN_STATE, st)
    log(f"[scan] 候选 {len(cands)}，自动登记 {len(added)}")
    return {'added': added, 'candidates': st['candidates'], 'at': st['lastRun']}


def cmd_scan(argv):
    cfg = load_json(CONFIG, {})

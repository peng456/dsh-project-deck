        projects.append({'path': path, 'name': os.path.basename(path), 'markers': meta.get('markers', []),
                         'git': git_info(path), 'last': meta.get('last', 0)})
    try:
        save_node_scan({'node': node['id'], 'token': node.get('token', ''),
                        'platform': 'darwin', 'projects': projects})
        log(f'[node] 本机快照已刷新（{len(projects)} 个项目）')

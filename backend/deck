def daemon_status():
    pid = None
    if os.path.exists(LOCK):
        try:
            with open(LOCK) as f:
                pid = int(f.read().strip() or 0)
            os.kill(pid, 0)
        except (ValueError, ProcessLookupError, PermissionError):
            pid = None
    return pid


def cmd_doctor():
    reg = load_json(REGISTRY, {'projects': []})
    problems, warnings = [], []
    seen = {}
    for p in reg.get('projects', []):
        pid, root = p['id'], p.get('root', '')
        if root in seen:
            problems.append(f'{pid}: 根目录与 {seen[root]} 重复绑定（{root}）')
        seen[root] = pid
        if not os.path.isdir(root):
            problems.append(f'{pid}: 目录不存在 {root}')
            continue
        if p.get('memory') and not state_file(p):
            problems.append(f'{pid}: 记忆缺失（STATE 不存在）')
        if not os.path.isdir(os.path.join(root, '.dsh-graph')):
            warnings.append(f'{pid}: 无执行看板（.dsh-graph 缺失）')
        if not p.get('memory'):
            warnings.append(f'{pid}: 未落盘（无 ~/.ai STATE）')
    print(f'项目 {len(reg.get("projects", []))} 个，问题 {len(problems)}，提示 {len(warnings)}')
    for x in problems:
        print('  ✗ ' + x)
    for x in warnings:
        print('  · ' + x)
    return 0 if not problems else 1



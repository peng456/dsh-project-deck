{
  "name": "dsh-project-deck",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin: a personal project control panel — project registry, 4-hour WeChat reports (text + chart image), auto-discovery of new projects, and multi-node scanning.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": { "default": "./lib/index.js" },
    "./client": { "default": "./lib/client.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  },
  "files": ["lib", "cordis.patch.yml", "backend", "README.md", "LICENSE"],
  "keywords": ["dsh", "deepseek-harness", "plugin", "project-management", "wechat", "dashboard"],
  "license": "MIT",
  "engines": { "node": ">=22.15" },
  "repository": { "type": "git", "url": "https://github.com/peng456/dsh-project-deck" }
}
